# 这台机器 core.autocrlf=true，会让 gradlew 这种 shell 脚本在检出时被换成 CRLF，
# 换到 Git Bash / macOS / Linux 下就跑不起来了。这里按文件类型把行尾钉死。

* text=auto

# 源码统一用 LF，避免历史里出现整文件行尾变更的噪音 diff
*.kt      text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.pro     text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# 两个平台的启动脚本各自的行尾是硬要求
gradlew       text eol=lf
gradlew.bat   text eol=crlf

# 二进制，不要做任何行尾转换
*.jar     binary
*.png     binary
*.webp    binary
*.jks     binary
*.keystore binary
